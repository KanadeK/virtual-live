# Offline defaults. Put real credentials only in ignored .env, never in frontend files.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_MAX_OUTPUT_TOKENS=96
AI_MAX_REPLY_CHARS=45
AI_DAILY_REQUEST_LIMIT=10
TTS_PROVIDER=browser
# Choose API Key (new console), OR App ID + Access Token (old console).
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_AUTH_MODE=apiKey
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
# Set DOUBAO_TTS_AUTH_MODE=appToken when using App ID + Access Token.
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_gujie_uranus_bigtts
TTS_DAILY_CHAR_LIMIT=500
PAID_AUTO_ENABLED=false
PROVIDER_TIMEOUT_SECONDS=20
OUTBOUND_PROXY_URL=
LIVE_EVENT_SOURCE=mock
SERVER_PORT=8080
MOCK_MIN_SECONDS=5
MOCK_MAX_SECONDS=15

# 音源显式选择：local / http / qq-awoo，默认 local；旧netease配置已停用且明确报错。
MUSIC_PROVIDER=local
# qq-awoo 需另行完成正常QQ/Awoo运行验收；默认仍为local。令牌文件只由后端读取。
MUSIC_QQ_BRIDGE_URL=
MUSIC_QQ_BRIDGE_TOKEN_FILE=
# http 模式需独立本机适配器；协议见 docs/music-integration.md。
MUSIC_GATEWAY_URL=
# 可选嗷呜只读状态入口，例如 http://127.0.0.1:5556，不提供点歌控制。
MUSIC_AWOO_STATE_URL=
# 仅历史底层测试保留；生产catalog不会调用网易入口。
NETEASE_SEARCH_URL=https://music.163.com/api/search/get
# 无用户点歌时回退本地音乐，路径相对 backend 工作目录，默认循环。
LOCAL_MUSIC_DIR=../defaultBackgroundMusic
LOCAL_MUSIC_ENABLED=true
# 抖音采集仍使用 Lightweight；仅扫码登录助手需要本机 Google Chrome。
# 可选：采集进程 HTTP/WebSocket 代理；留空表示不使用代理。
DOUYIN_PROXY_URL=
# DOUYIN_NODE=node
# DOUYIN_WORKER=../collector/dist/worker.js

# Optional backend endpoints and isolated provider storage (defaults shown).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# PROVIDER_DATA_DIR=../.runtime/providers

# B站采集使用正常API下发的弹幕token。游客受限时请在管理台点击官方登录。
# Cookie仅通过本次请求/worker stdin传入，不配置到环境文件。
# BILIBILI_NODE=node
# BILIBILI_WORKER=../collector/dist/bilibili/worker.js

# 鱼干独立账本位于 PROVIDER_DATA_DIR/fish-balance.json；以下只在首次创建时生效。
# 已有账本优先，修改开账值不会重置余额；房间不匹配会保持不可用。
FISH_OPENING_BALANCE=0
FISH_ROOM_ID=
